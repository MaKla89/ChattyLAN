# ChattyLAN — Docker environment file
# Copy this file to `.env` (same folder as docker-compose.yml) and fill in what
# you need. `.env` is gitignored; this example is safe to commit.
# All variables are optional — leave a line empty/commented to keep the default.

# Encrypt per-user chat data at rest (AES-256-GCM). Pick a long random value,
# e.g.:  openssl rand -hex 32
# WARNING: if you lose this key, existing encrypted chats cannot be recovered.
DATA_KEY=

# Pre-create an account on first boot (only used while no users exist yet).
# Leave empty to create the first account via the web UI instead.
INITIAL_USER=
INITIAL_PASSWORD=

# Set to 0 to disable self-registration entirely (only pre-created users can log in).
# Default: registration open until MAX_USERS accounts exist.
#ALLOW_REGISTER=0
